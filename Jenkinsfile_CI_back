pipeline {
    agent {docker {
        image 'docker:latest'
        args '-u root --privileged'
    }}

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Compose start') {
            steps {
                sh "docker-compose up -d"
                sh '''
                    sleep 40
                    docker-compose logs everest_back
                '''
            }
        }
        stage('Test request') {
            steps {
                sh "apk add curl"
                sh '''
                    docker exec -i everest_back-everest_back-1 curl --write-out \"%{http_code}\" --silent --output /dev/null http://localhost:8000/ > status_code.txt
                    if [ "\"200\"" == $(cat status_code.txt) ]
                        then
                            cat status_code.txt
                        else
                            echo "ERROR: Response code is not equals 200"
                            echo "Status code is $(cat status_code.txt)"
                            exit 1
                    fi
                '''
            }
        }
        stage('Compose down') {
            steps {
                echo "Stoping"
                sh '''
                    docker-compose down
                    rm status_code.txt
                '''
                echo "Successful stoped"
            }
        }
    }
    post {
        // Clean after build
        always {
            cleanWs deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true
        }

        // Manualy stop and delete docker conytainers and images
        failure {
            sh '''
                container_names=($(docker ps -a --format {{.Names}}))
                image_names=($(docker images --format {{.Repository}}))

                if [ ${#container_names[*]} > 1 ]
                then
                    for container in ${container_names[*]}
                    do
                        if [ $container != "jenkins" ]
                        then
                                if [ $(docker inspect $container --format {{.State.Status}}) == "running" ]
                                then
                                    docker stop $container
                                    docker rm $container
                                else
                                    docker rm $container
                                fi
                        fi
                    done
                    for image_name in ${image_names[*]}
                    do
                        if [ $image_name != "jenkins/jenkins" ]
                        then
                            docker rmi $image_name
                        fi
                    done
                fi
            '''
        }
    }
}
