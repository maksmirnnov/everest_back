    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Compose start') {
            steps {
                sh "docker-compose up -d"
                // sh '''
                //     sleep 25
                //     docker-compose logs
                // '''
            }
        }
        stage('Test request') {
            steps {
                sh '''#!/bin/bash

                    docker exec -i everest_back-nginx-1 curl --write-out %{http_code} --silent --output /dev/null -H "Host: everest.smirnnov.ru" http://127.0.0.1/ > status_code200.txt
                    docker exec -i everest_back-nginx-1 curl --write-out %{http_code} --silent --output /dev/null http://127.0.0.1/ > status_code400.txt
                    if [ "200" == $(cat status_code200.txt) ] && [ "400" == $(cat status_code400.txt) ]
                        then
                            cat status_code200.txt
                            cat status_code400.txt
                        else
                            echo "ERROR: Response code is not equals 200"
                            echo "Status code is $(cat status_code200.txt)"
                            echo "Status code is $(cat status_code400.txt)"
                            exit 1
                    fi
                '''
            }
        }
    }
    post {
        // Clean after build
        always {
            sh "docker-compose down"
            sh "docker-compose down"
            cleanWs deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true
