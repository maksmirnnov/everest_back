pipeline {
    agent {docker {
        image 'docker:latest'
        args '-u root'
    }}

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Compose start') {
            steps {
                sh "docker-compose up -d"
            }
        }
        stage('Test request') {
            steps {
                sh "apk add curl"
                sh '''
                    echo $(curl --write-out \"%{http_code}\" --silent --output /dev/null http://localhost:8000/) > status_code.txt
                    if [ "\"200\"" == $(cat status_code.txt) ]
                        then
                            cat status_code.txt
                        else
                            echo "ERROR: Response code is not equals 200"
                            echo "Status code is $(cat status_code.txt)"
                            exit 1
                    fi
                '''
            }
        }
        stage('Compose down') {
            steps {
                echo "Stoping"
                sh '''
                    docker-compose down
                    rm status_code.txt
                '''
                echo "Successful stoped"
            }
        }
    }
}
