pipeline {
    agent {docker {
        image 'python:latest'
        args '-u root'
    }}

    options {
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Create venv') {
            steps {
                echo "Start creating venv"
                sh "python -m venv ./venv"
                sh ". ./venv/bin/activate"
                echo "Venv created"
            }
        }
        stage('Install dependencies') {
            steps {
                echo "Start install dependencies"
                sh "pip install -r requirements.txt --root-user-action ignore"
                echo "End install dependencies"
            }
        }
        stage('Test start') {
            steps {
                echo "Starting"
                sh '''
                    nohup python manage.py runserver &> test_start.log & echo $! > save_pid.txt
                    sleep 10
                    echo "--- --- ---"
                    echo "test start log:"
                    sh "cat test_start.log"
                    echo "--- --- ---"
                '''
                echo "Successful started"
            }
        }
        stage('Test request') {
            steps {
                sh '''
                    echo $(curl --write-out \"%{http_code}\" --silent --output /dev/null http://localhost:8000/) > status_code.txt
                    if [ "\"200\"" == $(cat status_code.txt) ]
                        then
                            cat status_code.txt
                        else
                            echo "ERROR: Response code is not equals 200"
                            echo "Status code is $(cat status_code.txt)"
                            exit 1
                    fi
                '''
            }
        }
        stage('Stop test server') {
            steps {
                echo "Stoping"
                sh '''kill $(cat save_pid.txt)'''
                sh "rm save_pid.txt"
                sh "rm test_start.txt"
                echo "Successful stoped"
            }
        }
    }
}
