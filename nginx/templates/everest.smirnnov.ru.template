upstream gunicorn_server {
    server everest_back:${BACK_PORT} fail_timeout=0;
}

server {
    listen ${NGINX_PORT} default_server;
    listen [::]:${NGINX_PORT} default_server ipv6only=on;

    server_name localhost;
    
    keepalive_timeout 5;

    location / {
        proxy_pass      http://gunicorn_server/;
        include         proxy_params;
        # proxy_redirect  off;
    }

    location /static {
        alias           /etc/nginx/static/static;
    }

    location /assets {
        alias           /etc/nginx/static/assets;
    }

    location /media {
        alias           /etc/nginx/media;
    }

    location = /favicon.svg {
        alias           /etc/nginx/static/favicon.svg;
    }
}
